rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isRole(role) {
      return isSignedIn() && getUserData(request.auth.uid).role == role;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isRole('admin');
      allow create: if isSignedIn() && isOwner(userId) && 
                      request.resource.data.role in ['student', 'faculty'] &&
                      request.resource.data.uid == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isRole('admin')) &&
                      (isOwner(userId) ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']) : true);
    }

    // --- Resources (Notes/PYQs) ---
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isRole('faculty') || isRole('admin');
      allow update, delete: if isRole('admin') || (isRole('faculty') && resource.data.uploadedBy == request.auth.uid);
    }

    // --- Library Books ---
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isRole('admin') || isRole('librarian');
    }

    // --- Events ---
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isRole('faculty') || isRole('admin');
      allow update: if isRole('admin') || (isRole('faculty') && resource.data.organizer == getUserData(request.auth.uid).displayName);
      allow delete: if isRole('admin');
    }

    // --- Attendance ---
    match /attendance/{attendanceId} {
      allow read: if isRole('admin') || isRole('faculty') || (isRole('student') && resource.data.studentId == request.auth.uid);
      allow create: if isRole('faculty') || isRole('admin');
      allow update, delete: if isRole('admin');
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == null || resource.data.userId == request.auth.uid);
      allow create: if isRole('admin') || isRole('faculty');
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isRole('admin');
    }
  }
}
